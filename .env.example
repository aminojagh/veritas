# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# Veritas supports two Large Language Model providers and no others —
# `.claude/docs/adr/0005-one-openai-compatible-endpoint-for-every-provider.md`.
# Nothing else Veritas touches needs a key: every data source is open, and the
# Postgres and Grafana credentials are generated by `docker-compose`.

# Required. The key the Large Language Model Zoomcamp already asks you for.
OPENAI_API_KEY=

# Optional, and free — https://console.groq.com/keys, no card. Needed only to
# reproduce the two-model comparison in the evaluation; the app runs without it.
GROQ_API_KEY=

# Optional. Which of the two answers, and which model on it. Defaults are
# `openai` and that provider's own default — `gpt-5.4-mini` for OpenAI,
# `openai/gpt-oss-120b` for Groq.
# VERITAS_LLM_PROVIDER=
# VERITAS_LLM_MODEL=

# The tests that spend a real key are opt-in on the command line —
# `VERITAS_LIVE_MODEL=1 uv run pytest …` — and deliberately have no field here:
# this file is read on every run, and a key being present is not consent.
