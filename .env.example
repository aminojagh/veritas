# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# Veritas supports two Large Language Model providers and no others —
# `.claude/docs/adr/0005-one-openai-compatible-endpoint-for-every-provider.md`.
# The only key you must supply is the first one below: every data source is open,
# and the Postgres credentials are filled in already.

# Required. The key the Large Language Model Zoomcamp already asks you for.
OPENAI_API_KEY=

# Optional, and free — https://console.groq.com/keys, no card. Needed only to
# reproduce the two-model comparison in the evaluation; the app runs without it.
GROQ_API_KEY=

# Optional. Which of the two answers, and which model on it. Defaults are
# `openai` and that provider's own default — `gpt-5.4-mini` for OpenAI,
# `openai/gpt-oss-120b` for Groq.
# VERITAS_LLM_PROVIDER=
# VERITAS_LLM_MODEL=

# The tests that spend a real key are opt-in on the command line —
# `VERITAS_LIVE_MODEL=1 uv run pytest …` — and deliberately have no field here:
# this file is read on every run, and a key being present is not consent.

# The Question Log. `docker-compose.yml` creates the server from these three and
# the App connects to it over the two below, so this is one set of credentials
# rather than two that have to be kept equal. The password is a generated value
# rather than a placeholder, so `docker compose up -d postgres` works on a fresh
# clone with nothing typed; change it if this ever leaves a laptop.
POSTGRES_USER=veritas
POSTGRES_PASSWORD=dITDTj_rw8DV98NiIg1bMTO3
POSTGRES_DB=veritas
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Grafana, which charts the Question Log — http://localhost:3000 once
# `docker compose up` is done. The dashboard is the page that opens and reading it
# needs no sign-in; these two are for editing anything, and are generated values
# rather than the `admin`/`admin` the image would otherwise take.
GRAFANA_USER=admin
GRAFANA_PASSWORD=jhlDcZISMk_5FWvkULvu24Eu
GRAFANA_PORT=3000
